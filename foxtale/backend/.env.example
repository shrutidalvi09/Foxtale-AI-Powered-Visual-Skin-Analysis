# Copy this file to backend/.env and fill in the values from Meta's WhatsApp Cloud API setup.
# This file is read only by the backend; the token never reaches the browser.

# Permanent (system user) access token, and the Phone number ID shown on the API Setup page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Names of the two message templates you create (see README). Language code must match the template.
WHATSAPP_OTP_TEMPLATE=foxtale_verify
WHATSAPP_REPORT_TEMPLATE=foxtale_report
WHATSAPP_WEEKLY_TEMPLATE=foxtale_weekly
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# Set to 1 to try the whole flow without sending anything: codes and reports are printed in the
# backend console instead. Remove it (or set 0) when you go live.
# WHATSAPP_DRY_RUN=1

# --- Custom Skin AI (core/skin_ai_*.py) -------------------------------------------------
# Still off for everyone until a user turns on "AI insights" consent in Settings, even with
# these set. AI_PROVIDER: anthropic | mock | openai | gemini (only anthropic and mock are
# implemented; see core/skin_ai_provider.py).
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Set to 1 to try the whole AI flow with no account and no cost: a canned, schema-valid
# result is returned instead of calling any provider. Remove it (or set 0) to go live.
# AI_DRY_RUN=1

# Optional tuning (sensible defaults in core/skin_ai_config.py if left unset):
# AI_MAX_OUTPUT_TOKENS=1400
# AI_TIMEOUT_S=45
# AI_IMAGE_MAX_DIM=512
# AI_IMAGE_JPEG_QUALITY=82
# AI_RATE_LIMIT_PER_MIN=6
# AI_CACHE_TTL_DAYS=30

# --- Voice Guide (core/guide_*.py) ------------------------------------------------------
# Still off for everyone until a user turns on "Voice assistant" in Settings. Text-only --
# never receives the face photo or audio, only a short transcript. Reuses ANTHROPIC_API_KEY
# above. GUIDE_PROVIDER: anthropic | mock (only these two are implemented).
GUIDE_PROVIDER=anthropic
GUIDE_MODEL=claude-sonnet-5

# Set to 1 to try the whole flow with no account and no cost: a canned reply is used for
# anything the local command matcher doesn't recognise, instead of calling any provider.
# GUIDE_DRY_RUN=1

# Optional tuning (sensible defaults in core/guide_config.py if left unset):
# GUIDE_MAX_OUTPUT_TOKENS=300
# GUIDE_TIMEOUT_S=15
# GUIDE_RATE_LIMIT_PER_MIN=20
# GUIDE_SESSION_TTL_MIN=30
# GUIDE_TRANSCRIPT_RETENTION_DAYS=30
