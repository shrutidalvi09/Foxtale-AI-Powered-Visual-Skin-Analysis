# Copy this file to backend/.env and fill in the values from Meta's WhatsApp Cloud API setup.
# This file is read only by the backend; the token never reaches the browser.

# Permanent (system user) access token, and the Phone number ID shown on the API Setup page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Names of the two message templates you create (see README). Language code must match the template.
WHATSAPP_OTP_TEMPLATE=foxtale_verify
WHATSAPP_REPORT_TEMPLATE=foxtale_report
WHATSAPP_WEEKLY_TEMPLATE=foxtale_weekly
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# Set to 1 to try the whole flow without sending anything: codes and reports are printed in the
# backend console instead. Remove it (or set 0) when you go live.
# WHATSAPP_DRY_RUN=1
